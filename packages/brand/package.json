{
	"name": "@shared-next/brand",
	"version": "0.1.0",
	"description": "Brand config (name, colours, icons, ids, hosts) of the *-next products: schema, browser-safe loader, manifest/icon generator and product-name checker",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"exports": {
		".": "./src/index.ts",
		"./hosts": "./src/hosts.ts",
		"./build": "./src/build.ts",
		"./check-brand": "./src/check-brand.ts",
		"./brand.config.schema.json": "./brand.config.schema.json",
		"./package.json": "./package.json"
	},
	"bin": {
		"check-brand": "./src/check-brand/bin.ts"
	},
	"files": ["src", "brand.config.schema.json", "README.md"],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
		"test": "vitest run --maxWorkers=2"
	},
	"dependencies": {
		"ajv": "8.20.0"
	},
	"peerDependencies": {
		"tsx": ">=4"
	},
	"peerDependenciesMeta": {
		"tsx": {
			"optional": true
		}
	}
}
