{
	"name": "@achoo254/brand",
	"version": "0.3.0",
	"description": "Brand config (name, colours, icons, ids, hosts) of the *-next products: schema, browser-safe loader, manifest/icon generator and product-name checker",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./hosts": {
			"types": "./dist/hosts.d.ts",
			"default": "./dist/hosts.js"
		},
		"./build": {
			"types": "./dist/build.d.ts",
			"default": "./dist/build.js"
		},
		"./check-brand": {
			"types": "./dist/check-brand.d.ts",
			"default": "./dist/check-brand.js"
		},
		"./brand.config.schema.json": "./brand.config.schema.json",
		"./package.json": "./package.json"
	},
	"bin": {
		"check-brand": "./dist/check-brand/bin.js"
	},
	"files": ["dist", "brand.config.schema.json", "README.md", "LICENSE"],
	"scripts": {
		"build": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node --eval \"require('node:fs').chmodSync('dist/check-brand/bin.js',0o755)\" && node --eval \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\"",
		"typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
		"test": "vitest run --maxWorkers=2"
	},
	"dependencies": {
		"ajv": "8.20.0"
	},
	"license": "MIT",
	"author": "achoo254",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/achoo254/shared-next.git",
		"directory": "packages/brand"
	},
	"homepage": "https://github.com/achoo254/shared-next/tree/main/packages/brand#readme",
	"bugs": {
		"url": "https://github.com/achoo254/shared-next/issues"
	},
	"keywords": ["brand", "design-tokens", "pwa-manifest"],
	"publishConfig": {
		"access": "public"
	}
}
