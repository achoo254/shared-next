{
	"name": "shared-next",
	"private": true,
	"type": "module",
	"description": "Shared packages of the *-next products (chat, scribe, localman, miu-world)",
	"engines": {
		"node": ">=22.12"
	},
	"packageManager": "pnpm@11.9.0",
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
		"test": "pnpm -r --workspace-concurrency=1 test"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "22.20.5",
		"typescript": "6.0.3",
		"vitest": "3.2.7"
	}
}
